@page
@model SistemaAsiloLogin.Pages.VisitasMedicasModel

@{
    ViewData["Title"] = "Visitas Médicas";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/solicitudes-citas.css"
          asp-append-version="true" />
}

<div class="modulo-medico">

<div class="modulo-encabezado">
        <h2>Visitas Médicas</h2>
        <p class="modulo-descripcion">
            Registra y consulta las visitas de atención médica.
        </p>
    </div>

<form method="post" class="formulario-modulo">

    <div class="campo-modulo">

        <label>Cita Médica</label>

        
<select asp-for="Visita.IdCita">
    <option value="">Seleccione una cita</option>

    @foreach (var cita in Model.Citas)
    {
        <option value="@cita.IdCita"
                data-paciente="@(cita.SolicitudMedica?.Paciente == null
                    ? ""
                    : cita.SolicitudMedica.Paciente.Nombres + " " +
                      cita.SolicitudMedica.Paciente.Apellidos)"
                data-medico="@(cita.Medico == null
                    ? ""
                    : cita.Medico.Nombres + " " +
                      cita.Medico.Apellidos)">

            Cita #@cita.IdCita -
            @cita.SolicitudMedica?.Paciente?.Nombres
            @cita.SolicitudMedica?.Paciente?.Apellidos -
            @cita.Medico?.Nombres
            @cita.Medico?.Apellidos -
            @cita.FechaCita.ToString("dd/MM/yyyy HH:mm")

        </option>
    }
</select>

    </div>


<div class="campo-modulo">

    <label>Paciente asignado</label>

    <input type="text"
           id="pacienteAsignado"
           readonly
           placeholder="Seleccione primero una cita médica" />

    <small>
        El paciente se obtiene automáticamente de la cita.
    </small>

</div>


<div class="campo-modulo">

    <label>Médico asignado</label>

    <input type="text"
           id="medicoAsignado"
           readonly
           placeholder="Seleccione primero una cita médica" />

    <small>
        El médico se obtiene automáticamente de la cita.
    </small>

</div>


    <div class="campo-modulo">

        <label>Fecha de visita</label>

        <input asp-for="Visita.FechaVisita"
               type="datetime-local" />

    </div>

    <div class="campo-modulo">

        <label>Motivo de consulta</label>

        <textarea asp-for="Visita.MotivoConsulta"
                  rows="4"
                  placeholder="Ingrese el motivo de la consulta"></textarea>

    </div>

    <div class="campo-modulo">

        <label>Diagnóstico</label>

        <textarea asp-for="Visita.Diagnostico"
                  rows="4"
                  placeholder="Ingrese el diagnóstico"></textarea>

    </div>

    <div class="campo-modulo">

        <label>Observaciones</label>

        <textarea asp-for="Visita.Observaciones"
                  rows="4"
                  placeholder="Ingrese observaciones médicas"></textarea>

    </div>


    <div asp-validation-summary="All"
     class="text-danger campo-completo"></div>

   <button type="submit" class="btn-modulo campo-completo">
    Registrar Visita
</button>

</form>


<h3 class="seccion-registros">Visitas Registradas</h3>

<div class="tabla-responsive">
    <table class="tabla-modulo">

    <thead>

        <tr>
            <th>ID</th>
            <th>Cita</th>
            <th>Paciente</th>
            <th>Médico</th>
            <th>Fecha</th>
            <th>Motivo</th>
            <th>Diagnóstico</th>
            <th>Observaciones</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var visita in Model.Visitas)
        {
            <tr>

                <td>
                    @visita.IdVisita
                </td>

                <td>
                    @visita.IdCita
                </td>

                <td>
                    @visita.Paciente?.Nombres
                    @visita.Paciente?.Apellidos
                </td>

                <td>
                    @visita.Medico?.Nombres
                    @visita.Medico?.Apellidos
                </td>

                <td>
                    @visita.FechaVisita.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>
                    @visita.MotivoConsulta
                </td>

                <td>
                    @visita.Diagnostico
                </td>

                <td>
                    @visita.Observaciones
                </td>

            </tr>
        }

    </tbody>

</table>
</div>
</div>

                    
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const citaSelect =
                document.getElementById("Visita_IdCita");

            const pacienteInput =
                document.getElementById("pacienteAsignado");

            const medicoInput =
                document.getElementById("medicoAsignado");

            function actualizarDatos() {

                const opcion =
                    citaSelect.options[citaSelect.selectedIndex];

                const paciente =
                    opcion?.getAttribute("data-paciente") || "";

                const medico =
                    opcion?.getAttribute("data-medico") || "";

                pacienteInput.value = paciente;
                medicoInput.value = medico;
            }

            citaSelect.addEventListener(
                "change",
                actualizarDatos
            );

            actualizarDatos();
        });
    </script>
}
