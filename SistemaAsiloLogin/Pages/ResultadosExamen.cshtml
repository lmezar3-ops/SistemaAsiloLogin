@page
@model SistemaAsiloLogin.Pages.ResultadosExamenModel

@{
    ViewData["Title"] = "Resultados de Exámenes";
}

@section Styles {
    <link rel="stylesheet" href="~/css/solicitudes-citas.css" asp-append-version="true" />
}

<div class="modulo-medico">

    <a asp-page="/ExamenesLaboratorio"
       class="btn btn-outline-secondary mb-3">
        ← Volver a Exámenes de Laboratorio
    </a>
    
    @if (TempData["Mensaje"] != null)
    {
        <p class="mensaje-exito">@TempData["Mensaje"]</p>
    }

    @if (TempData["Error"] != null)
    {
        <p class="mensaje-error">@TempData["Error"]</p>
    }


    <div class="modulo-encabezado">
        <h2>Resultados de Exámenes</h2>
        <p class="modulo-descripcion">
            Registra y consulta los resultados de los exámenes de laboratorio.
        </p>
    </div>

<form method="post" class="formulario-modulo">

  
<div class="campo-modulo">

    <label>Examen</label>

    @if (Model.Examenes.Any())
    {
      <select asp-for="Resultado.IdExamen">
    <option value="">Seleccione un examen</option>

    @foreach (var examen in Model.Examenes)
    {
        <option value="@examen.IdExamen">
            Examen #@examen.IdExamen - @examen.NombreExamen
        </option>
    }
</select>

<span asp-validation-for="Resultado.IdExamen"
      class="text-danger"></span>
}
else
{
    <p class="mensaje-error">
        No hay exámenes pendientes de resultado.
        Los exámenes cancelados o que ya tienen un resultado
        no están disponibles para registrar otro.
    </p>
  }

</div>

    <div class="campo-modulo">
    <label>Resultado</label>

    <textarea asp-for="Resultado.Resultado"
              rows="5"
              placeholder="Ingrese el resultado del examen"></textarea>

    <span asp-validation-for="Resultado.Resultado"
          class="text-danger"></span>
</div>

    <div class="campo-modulo">

        <label>Fecha del resultado</label>
<input asp-for="Resultado.FechaResultado"
       type="datetime-local" />
<span asp-validation-for="Resultado.FechaResultado"
      class="text-danger"></span>

    </div>

    <div class="campo-modulo">

        <label>Observaciones</label>

        <textarea asp-for="Resultado.Observaciones"
                  rows="4"
                  placeholder="Ingrese observaciones del resultado"></textarea>

    </div>

   <button type="submit" class="btn-modulo campo-completo">
    Registrar Resultado
</button>

</form>

<hr />

<h3 class="seccion-registros">Resultados Registrados</h3>

<div class="tabla-responsive">
    <table class="tabla-modulo">

    <thead>

        <tr>
            <th>ID</th>
            <th>Examen</th>
            <th>Resultado</th>
            <th>Fecha</th>
            <th>Observaciones</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var resultado in Model.Resultados)
        {
            <tr>

                <td>
                    @resultado.IdResultado
                </td>

                <td>
                    @resultado.ExamenLaboratorio?.NombreExamen
                </td>

                <td>
                    @resultado.Resultado
                </td>

                <td>
                    @resultado.FechaResultado.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>
                    @resultado.Observaciones
                </td>

            </tr>
        }

       </tbody>
    </table>
</div>
</div>