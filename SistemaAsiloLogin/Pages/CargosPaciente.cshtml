@page
@model SistemaAsiloLogin.Pages.CargosPacienteModel

@{
    ViewData["Title"] = "Cargos de Pacientes";
}

@section Styles {
    <link rel="stylesheet" href="~/css/solicitudes-citas.css" asp-append-version="true" />
}

<div class="modulo-medico">
    <a asp-page="/CajaPagos" class="btn btn-outline-secondary mb-3">
    ← Volver a Caja y Pagos
</a>
    <div class="modulo-encabezado">
        <h2>Cargos de Pacientes</h2>
        <p class="modulo-descripcion">
            Registra cargos, administra descuentos y consulta los montos pendientes.
        </p>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="alert">
        @mensaje
    </div>
}

<form method="post" class="formulario-modulo">

    <div asp-validation-summary="All"
     class="text-danger mb-3"></div>

    <div class="campo-modulo">
        <label>Paciente</label>

        <select asp-for="Cargo.IdPaciente">
            <option value="">Seleccione un paciente</option>

            @foreach (var paciente in Model.Pacientes)
            {
                <option value="@paciente.IdPaciente">
                    @paciente.Nombres @paciente.Apellidos
                </option>
            }
        </select>
    </div>

    <div class="campo-modulo">
        <label>Fundación</label>

        <select asp-for="Cargo.IdFundacion">
            <option value="">Seleccione una fundación</option>

            @foreach (var fundacion in Model.Fundaciones)
            {
                <option value="@fundacion.IdFundacion">
                    @fundacion.Nombre
                </option>
            }
        </select>
    </div>

    <div class="campo-modulo">
        <label>Fecha del cargo</label>

        <input asp-for="Cargo.FechaCargo"
                 asp-format="{0:yyyy-MM-ddTHH:mm}"
                 type="datetime-local"
                 step="60" />
    </div>

    <div class="campo-modulo">
        <label>Tipo de cargo</label>

        <select asp-for="Cargo.TipoCargo">
            <option value="">Seleccione un tipo</option>
            <option value="Consulta">Consulta</option>
            <option value="Examen">Examen</option>
            <option value="Medicamento">Medicamento</option>
        </select>
    </div>

    <div class="campo-modulo">
        <label>Concepto</label>

        <input asp-for="Cargo.Concepto"
               placeholder="Ejemplo: Hemograma" />
    </div>

    <div class="campo-modulo">
        <label>Monto original</label>

        <input asp-for="Cargo.MontoOriginal"
               id="montoOriginal"
               type="number"
               step="0.01" />
    </div>

    <div class="campo-modulo">
       <label>Descuento (%)</label>

        <input id="porcentajeDescuento"
           type="number"
           value="20"
           readonly />
    </div>

    <div class="campo-modulo">
         <label>Descuento aplicado</label>

          <input asp-for="Cargo.Descuento"
               id="descuento"
               type="number"  
               step="0.01"
               readonly />

   </div>
    
   <div class="campo-modulo">
        <label>Monto final</label>

          <input asp-for="Cargo.MontoFinal"
               id="montoFinal"
               type="number"
               step="0.01"
               readonly />
    </div>

    
    <div class="campo-modulo">
        <label>Estado</label>
        <input type="text" value="Pendiente" class="form-control" readonly />
    </div>


    <button type="submit" class="btn-modulo campo-completo">
    Registrar Cargo
</button>

</form>

<hr />

<h3 class="seccion-registros">Cargos Registrados</h3>

<div class="tabla-responsive">
    <table class="tabla-modulo">
    <thead>
        <tr>
            <th>ID</th>
            <th>Paciente</th>
            <th>Fundación</th>
            <th>Fecha</th>
            <th>Tipo</th>
            <th>Concepto</th>
            <th>Monto Original</th>
            <th>Descuento</th>
            <th>Monto Final</th>
            <th>Estado</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var cargo in Model.Cargos)
        {
            <tr>
                <td>@cargo.IdCargo</td>

                <td>
                    @cargo.Paciente?.Nombres
                    @cargo.Paciente?.Apellidos
                </td>

                <td>
                    @cargo.Fundacion?.Nombre
                </td>

                <td>
                    @cargo.FechaCargo.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>
                    @cargo.TipoCargo
                </td>

                <td>
                    @cargo.Concepto
                </td>

                <td>
                    Q @cargo.MontoOriginal
                </td>

                <td>
                    Q @cargo.Descuento
                </td>

                <td>
                    Q @cargo.MontoFinal
                </td>

                <td>
                    @cargo.Estado
                </td>
            </tr>
        }

    </tbody>
    </table>
</div>

   <script>
    const montoOriginal = document.getElementById("montoOriginal");
    const porcentajeDescuento = document.getElementById("porcentajeDescuento");
    const descuento = document.getElementById("descuento");
    const montoFinal = document.getElementById("montoFinal");

    function calcularCargo() {
        const monto = parseFloat(montoOriginal.value) || 0;
        const porcentaje = 20;

        const descuentoCalculado = Math.round(
            (monto * porcentaje / 100 + Number.EPSILON) * 100
        ) / 100;

        const totalCalculado = monto - descuentoCalculado;

        descuento.value = descuentoCalculado.toFixed(2);
        montoFinal.value = totalCalculado.toFixed(2);
    }

    montoOriginal.addEventListener("input", calcularCargo);

    calcularCargo();
</script>
</div>