
@page
@model SistemaAsiloLogin.Pages.MedicamentosModel
@{
    ViewData["Title"] = "Medicamentos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/medicamentos.css" />
}

<h2>Administración de medicamentos</h2>

<div class="mb-4">
    <h4>Registrar medicamento</h4>

    <form id="formMedicamento">
        <div class="mb-3">
            <label for="nombreMedicamento" class="form-label">Nombre *</label>
            <input type="text"
                   class="form-control"
                   id="nombreMedicamento"
                   maxlength="150"
                   required />
        </div>

        <div class="mb-3">
            <label for="descripcionMedicamento" class="form-label">Descripción</label>
            <textarea class="form-control"
                      id="descripcionMedicamento"
                      maxlength="300"
                      rows="3"></textarea>
        </div>

        <div class="mb-3">
            <label for="existenciaMedicamento" class="form-label">Existencia *</label>
            <input type="number"
                   class="form-control"
                   id="existenciaMedicamento"
                   min="0"
                   step="1"
                   value="0"
                   required />
        </div>

        <div class="mb-3">
            <label for="fechaVencimientoMedicamento" class="form-label">Fecha de vencimiento</label>
            <input type="date"
                   class="form-control"
                   id="fechaVencimientoMedicamento" />
        </div>

        <div class="mb-3">
            <label for="costoMedicamento" class="form-label">Costo unitario *</label>
            <input type="number"
                   class="form-control"
                   id="costoMedicamento"
                   min="0"
                   max="99999999.99"
                   step="0.01"
                   value="0.00"
                   required />
        </div>

        <div class="form-check mb-3">
            <input type="checkbox"
                   class="form-check-input"
                   id="estadoMedicamento"
                   checked />
            <label for="estadoMedicamento" class="form-check-label">
                Medicamento activo
            </label>
        </div>

        <button type="submit" class="btn btn-success" id="btnGuardarMedicamento">
            Registrar medicamento
        </button>

        <button type="reset" class="btn btn-secondary">
            Limpiar formulario
        </button>
    </form>

    <div id="mensajeMedicamento" class="mt-3" role="status" aria-live="polite"></div>
</div>

<hr />

<div class="mb-3">
    <button type="button"
            class="btn btn-primary me-2"
            onclick="cargarInventario()">
        Consultar inventario completo
    </button>

    <button type="button"
            class="btn btn-warning"
            onclick="cargarMedicamentos()">
        Consultar próximos a vencer
    </button>
</div>


<div class="card mb-3 p-3">
    <label for="buscarMedicamento" class="form-label fw-bold">
        Buscar medicamento
    </label>

    <div class="input-group">
        <input type="search"
               id="buscarMedicamento"
               class="form-control"
               placeholder="Escribe un nombre, descripción o ID..."
               autocomplete="off" />

        <button type="button"
                id="limpiarBusquedaMedicamento"
                class="btn btn-outline-secondary">
            Limpiar búsqueda
        </button>
    </div>

    <small id="resultadoBusquedaMedicamento"
           class="text-muted mt-2"
           aria-live="polite">
        Consulta el inventario para comenzar la búsqueda.
    </small>
</div>


<table class="table table-bordered tabla-medicamentos">
    <thead>
        <tr>
            <th>ID</th>
            <th>Medicamento</th>
            <th>Descripción</th>
            <th>Existencia</th>
            <th>Fecha de vencimiento</th>
            <th>Costo</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody id="tablaMedicamentos">
        <tr>
            <td colspan="7">Selecciona una consulta para mostrar los medicamentos.</td>
        </tr>
    </tbody>
</table>

@section Scripts {
    <script src="~/js/medicamentos.js"></script>
}
