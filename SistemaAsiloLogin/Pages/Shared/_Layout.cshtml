<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaAsiloLogin</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/SistemaAsiloLogin.styles.css" asp-append-version="true" />
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-light mb-3">
            <div class="container">

                <a class="navbar-brand d-flex align-items-center gap-2"
                   asp-area=""
                   asp-page="/Index">
                    <img src="~/images/LogoAsilo.jpg"
                         alt="Logotipo del Asilo Cabeza de Algodón"
                         class="logo-asilo" />
                    <span>Sistema del Asilo</span>
                </a>


                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-inicio-dashboard"
                       asp-area=""
                       asp-page="/Dashboard"
                       title="Volver al menú principal"
                       aria-label="Volver al menú principal">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="21"
                             height="21"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <path d="m3 10 9-7 9 7"></path>
                            <path d="M5 9v12h14V9"></path>
                            <path d="M9 21v-8h6v8"></path>
                        </svg>
                        <span>Inicio</span>
                    </a>
                }
            </div>
        </nav>
    </header>

    <div class="container contenido-principal">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

        
        
     
    <footer class="border-top footer">
        <div class="container">
            &copy; 2026 - Sistema del Asilo Cabeza de Algodón
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
