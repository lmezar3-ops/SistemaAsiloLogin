@page
@model SistemaAsiloLogin.Pages.GastosModel

@{
    ViewData["Title"] = "Gastos";
}

<div class="container mt-4">
    <a asp-page="/CajaPagos" class="btn btn-outline-secondary mb-3">
    ← Volver a Caja y Pagos
</a>
    <h2>🛒 Registro de Gastos</h2>
    <p>Registra los gastos del asilo y consulta su historial.</p>

    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"></div>

    <div class="card p-4 mb-4">
        <h4>Registrar nuevo gasto</h4>

        <form method="post">
            <div class="mb-3">
                <label asp-for="Gasto.FechaGasto"
                       class="form-label">Fecha del gasto</label>
                <input asp-for="Gasto.FechaGasto"
                       type="date"
                       class="form-control"
                       required />
                <span asp-validation-for="Gasto.FechaGasto"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Gasto.TipoGasto"
                       class="form-label">Tipo de gasto</label>
                <select asp-for="Gasto.TipoGasto"
                        class="form-select"
                        required>
                    <option value="">Selecciona un tipo</option>
                    <option value="Alimentación">Alimentación</option>
                    <option value="Medicamentos">Medicamentos</option>
                    <option value="Servicios básicos">Servicios básicos</option>
                    <option value="Mantenimiento">Mantenimiento</option>
                    <option value="Personal">Personal</option>
                    <option value="Otros">Otros</option>
                </select>
                <span asp-validation-for="Gasto.TipoGasto"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Gasto.Concepto"
                       class="form-label">Concepto</label>
                <input asp-for="Gasto.Concepto"
                       class="form-control"
                       maxlength="200"
                       required />
                <span asp-validation-for="Gasto.Concepto"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Gasto.Monto"
                       class="form-label">Monto (Q)</label>
                <input asp-for="Gasto.Monto"
                       type="number"
                       class="form-control"
                       min="0.01"
                       step="0.01"
                       required />
                <span asp-validation-for="Gasto.Monto"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Gasto.Observaciones"
                       class="form-label">Observaciones (opcional)</label>
                <textarea asp-for="Gasto.Observaciones"
                          class="form-control"
                          rows="3"
                          maxlength="500"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                Registrar gasto
            </button>

            <a asp-page="/CajaPagos"
               class="btn btn-secondary ms-2">
                Volver a Caja y Pagos
            </a>
        </form>
    </div>

    <div class="card p-3 mb-4">
        <h5>Total de gastos registrados</h5>
        <h3>Q @Model.TotalGastos.ToString("N2")</h3>
        <small class="text-muted">
            Se calcula a partir de los gastos con estado Registrado.
        </small>
    </div>

    <h4>Historial de gastos</h4>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Concepto</th>
                    <th>Monto</th>
                    <th>Observaciones</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ListaGastos.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            No hay gastos registrados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var gasto in Model.ListaGastos)
                    {
                        <tr>
                            <td>@gasto.IdGasto</td>
                            <td>@gasto.FechaGasto.ToString("dd/MM/yyyy")</td>
                            <td>@gasto.TipoGasto</td>
                            <td>@gasto.Concepto</td>
                            <td>Q @gasto.Monto.ToString("N2")</td>
                            <td>@gasto.Observaciones</td>
                            <td>@gasto.Estado</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
