@page
@model SistemaAsiloLogin.Pages.CitasMedicasModel

@{
    ViewData["Title"] = "Citas Médicas";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/solicitudes-citas.css"
          asp-append-version="true" />
}

<div class="modulo-medico">

    <div class="modulo-encabezado">
        <h2>Citas Médicas</h2>
        <p class="modulo-descripcion">
            Programa citas y consulta la información de atención médica.
        </p>
    </div>


<form method="post" class="formulario-modulo">

    <div class="campo-modulo">

        <label>Solicitud Médica</label>

        <select asp-for="Cita.IdSolicitud">
            <option value="">Seleccione una solicitud</option>

            @foreach (var solicitud in Model.Solicitudes)
            {
                <option value="@solicitud.IdSolicitud"
            data-medico-nombre="@(solicitud.MedicoGeneral == null
                ? ""
                : solicitud.MedicoGeneral.Nombres + " " +
                  solicitud.MedicoGeneral.Apellidos)">
                  Solicitud #@solicitud.IdSolicitud -
                  @solicitud.Paciente?.Nombres
                  @solicitud.Paciente?.Apellidos -
                  @solicitud.Especialidad?.Nombre
                </option>
            }

        </select>

    </div>

    <div class="campo-modulo">

        <label>Médico</label>
 
           <input type="text"
           id="medicoAsignado"
           readonly
           placeholder="Seleccione primero una solicitud médica" />

     <small>
        El médico se obtiene automáticamente de la solicitud.
    </small>

    </div>

    <div class="campo-modulo">

        <label>Fecha y hora de la cita</label>

        <input asp-for="Cita.FechaCita"
               type="datetime-local" />

    </div>

    <div class="campo-modulo">

        <label>Estado Inicial</label>

       <input type="text"
           value="Programada"
           readonly />

    <small>
        La cita se registra inicialmente como Programada.
    </small>

    </div>

    <div class="campo-modulo">

        <label>Observaciones</label>

        <textarea asp-for="Cita.Observaciones"
                  rows="4"
                  placeholder="Ingrese observaciones de la cita"></textarea>

    </div>

    <div asp-validation-summary="All"
     class="text-danger campo-completo"></div>

    <button type="submit" class="btn-modulo campo-completo">
    Registrar Cita
</button>

</form>


<h3 class="seccion-registros">Citas Registradas</h3>

<div class="tabla-responsive">
    <table class="tabla-modulo">

    <thead>

        <tr>
            <th>ID</th>
            <th>Solicitud</th>
            <th>Paciente</th>
            <th>Médico</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Observaciones</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var cita in Model.Citas)
        {
            <tr>

                <td>
                    @cita.IdCita
                </td>

                <td>
                    @cita.IdSolicitud
                </td>

                <td>
                    @cita.SolicitudMedica?.Paciente?.Nombres
                    @cita.SolicitudMedica?.Paciente?.Apellidos
                </td>

                <td>
                    @cita.Medico?.Nombres
                    @cita.Medico?.Apellidos
                </td>

                <td>
                    @cita.FechaCita.ToString("dd/MM/yyyy HH:mm")
                </td>

                <td>
                    @cita.Estado
                </td>

                <td>
                    @cita.Observaciones
                </td>

            </tr>
        }

         </tbody>
    </table>
</div>

</div>

   @section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const solicitudSelect =
                document.getElementById("Cita_IdSolicitud");

            const medicoInput =
                document.getElementById("medicoAsignado");

            function actualizarMedico() {

                const opcion =
                    solicitudSelect.options[solicitudSelect.selectedIndex];

                const nombre =
                    opcion?.getAttribute("data-medico-nombre") || "";

                medicoInput.value = nombre;
            }

            solicitudSelect.addEventListener(
                "change",
                actualizarMedico
            );

            actualizarMedico();
        });
    </script>
}