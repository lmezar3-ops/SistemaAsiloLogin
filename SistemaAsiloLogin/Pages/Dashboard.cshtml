
@page
@model SistemaAsiloLogin.Pages.DashboardModel

@{
    ViewData["Title"] = "Menú Principal";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" />
}

<div class="container mt-4">
    <h1>Menú Principal - Sistema del Asilo</h1>
    <hr />

    <div class="row">

        @* Administración: solo Administrador *@
        @if (User.IsInRole("Administrador"))
        {
            <div class="col-md-4 mb-3">
                <a href="/AdministracionUsuarios"
                   style="text-decoration:none;color:inherit;">
                    <div class="dashboard-card">
                        <h3>👥 Administración de usuarios</h3>
                        <p>Registrar y consultar las cuentas del sistema.</p>
                    </div>
                </a>
            </div>
        }

        @* Gestión de pacientes *@
        @if (User.IsInRole("Administrador") ||
             User.IsInRole("MedicoGeneral") ||
             User.IsInRole("Medico") ||
             User.IsInRole("Enfermero"))
        {
            <div class="col-md-4 mb-3">
                <a href="/RegistroAncianos"
                   style="text-decoration:none;color:inherit;">
                    <div class="dashboard-card">
                        <h3>👴 Gestión de Pacientes</h3>
                        <p>Administración de pacientes.</p>
                    </div>
                </a>
            </div>

            <div class="col-md-4 mb-3">
                <a href="/PacientesRegistrados"
                   style="text-decoration:none;color:inherit;">
                    <div class="dashboard-card">
                        <h3>📋 Pacientes Registrados</h3>
                        <p>Consultar y buscar pacientes registrados.</p>
                    </div>
                </a>
            </div>
        }

        @* Familiares: solo Administrador según la autorización actual *@
        @if (User.IsInRole("Administrador"))
        {
            <div class="col-md-4 mb-3">
                <a href="/Familiares"
                   style="text-decoration:none;color:inherit;">
                    <div class="dashboard-card">
                        <h3>👨‍👩‍👧‍👦 Registro de Familiares</h3>
                        <p>Registro y consulta de familiares.</p>
                    </div>
                </a>
            </div>
        }

        @* Solicitudes médicas *@
        @if (User.IsInRole("Administrador") ||
             User.IsInRole("MedicoGeneral") ||
             User.IsInRole("Medico"))
        {
            <div class="col-md-4 mb-3">
                <a href="/SolicitudesMedicas"
                   style="text-decoration:none;color:inherit;">
                    <div class="dashboard-card">
                        <h3>📋 Solicitudes Médicas</h3>
                        <p>Registro y control de solicitudes médicas.</p>
                    </div>
                </a>
            </div>

            <div class="col-md-4 mb-3">
                <a href="/CitasMedicas"
                   style="text-decoration:none;color:inherit;">
                    <div class="dashboard-card">
                        <h3>🗓️ Citas Médicas</h3>
                        <p>Programación y control de citas médicas.</p>
                    </div>
                </a>
            </div>
        }

        @* Visitas médicas *@
        @if (User.IsInRole("Administrador") ||
             User.IsInRole("MedicoGeneral") ||
             User.IsInRole("Medico") ||
             User.IsInRole("Enfermero"))
        {
            <div class="col-md-4 mb-3">
                <a href="/VisitasMedicas"
                   style="text-decoration:none;color:inherit;">
                    <div class="dashboard-card">
                        <h3>🩺 Visitas Médicas</h3>
                        <p>Consultas, diagnósticos y expedientes médicos.</p>
                    </div>
                </a>
            </div>
        }

        
        @* Tratamientos médicos: personal clínico autorizado *@
        @if (User.IsInRole("Administrador") ||
             User.IsInRole("MedicoGeneral") ||
             User.IsInRole("Medico"))
        {
            <div class="col-md-4 mb-3">
                <a href="/Tratamientos"
                   style="text-decoration:none;color:inherit;">
                    <div class="dashboard-card">
                        <h3>💊 Tratamientos Médicos</h3>
                        <p>Registro y consulta de tratamientos asociados a visitas médicas.</p>
                    </div>
                </a>
            </div>
        }

        @* Laboratorio *@
        @if (User.IsInRole("Administrador") ||
             User.IsInRole("MedicoGeneral") ||
             User.IsInRole("Medico") ||
             User.IsInRole("Laboratorio"))
        {
            <div class="col-md-4 mb-3">
                <a href="/ExamenesLaboratorio"
                   style="text-decoration:none;color:inherit;">
                    <div class="dashboard-card">
                        <h3>🧪 Laboratorio</h3>
                        <p>Exámenes y resultados médicos.</p>
                    </div>
                </a>
            </div>
        }

        @* Farmacia *@
        @if (User.IsInRole("Administrador") ||
             User.IsInRole("MedicoGeneral") ||
             User.IsInRole("Medico") ||
             User.IsInRole("Enfermero") ||
             User.IsInRole("Farmacia"))
        {
            <div class="col-md-4 mb-3">
                <a href="/Medicamentos"
                   style="text-decoration:none;color:inherit;">
                    <div class="dashboard-card">
                        <h3>💊 Farmacia</h3>
                        <p>Gestión y control de medicamentos.</p>
                    </div>
                </a>
            </div>
        }

        @* Donaciones *@
        @if (User.IsInRole("Administrador") ||
             User.IsInRole("CajaFinanzas") ||
             User.IsInRole("Fundacion"))
        {
            <div class="col-md-4 mb-3">
                <a href="/Donaciones"
                   style="text-decoration:none;color:inherit;">
                    <div class="dashboard-card">
                        <h3>💰 Donaciones</h3>
                        <p>Registro y gestión de donaciones.</p>
                    </div>
                </a>
            </div>
        }

        @* Caja y Pagos *@
        @if (User.IsInRole("Administrador") ||
             User.IsInRole("CajaFinanzas"))
        {
            <div class="col-md-4 mb-3">
                <a href="/CajaPagos"
                   style="text-decoration:none;color:inherit;">
                    <div class="dashboard-card">
                        <h3>💵 Caja y Pagos</h3>
                        <p>Control de pagos, ingresos y egresos.</p>
                    </div>
                </a>
            </div>
        }

        @* Reportes: solo Administrador *@
        @if (User.IsInRole("Administrador"))
        {
            <div class="col-md-4 mb-3">
                <a href="/Reportes"
                   style="text-decoration:none;color:inherit;">
                    <div class="dashboard-card">
                        <h3>📊 Reportes</h3>
                        <p>Informes y consultas del sistema.</p>
                    </div>
                </a>
            </div>
        }

        <div class="col-12 text-center mt-4">
            <button type="button"
                    class="btn btn-danger"
                    onclick="cerrarSesion()">
                🚪 Cerrar Sesión
            </button>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        async function cerrarSesion() {
            try {
                const respuesta = await fetch('/api/Logout', {
                    method: 'POST'
                });

                if (respuesta.ok) {
                    window.location.href = "/";
                }
            }
            catch (error) {
                console.error(error);
            }
        }
    </script>
}
