@page
@model SistemaAsiloLogin.Pages.RelacionarFamiliaresModel

@{
    ViewData["Title"] = "Relacionar Familiares";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h2>Relacionar Familiares con Pacientes</h2>

        <a asp-page="/Familiares" class="btn btn-outline-secondary">
            Volver a Familiares
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Nueva relación familiar</h5>
        </div>

        <div class="card-body">
            <form method="post">

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="IdPaciente" class="form-label">
                        Paciente
                    </label>

                    <select asp-for="IdPaciente"
                            asp-items="Model.PacientesDisponibles"
                            class="form-select">
                        <option value="">Selecciona un paciente</option>
                    </select>

                    <span asp-validation-for="IdPaciente"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IdFamiliar" class="form-label">
                        Familiar
                    </label>

                    <select asp-for="IdFamiliar"
                            asp-items="Model.FamiliaresDisponibles"
                            class="form-select">
                        <option value="">Selecciona un familiar</option>
                    </select>

                    <span asp-validation-for="IdFamiliar"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Parentesco" class="form-label">
                        Parentesco con este paciente
                    </label>

                    <input asp-for="Parentesco"
                           class="form-control"
                           maxlength="100"
                           placeholder="Ej. Hijo, hija, sobrino..." />

                    <span asp-validation-for="Parentesco"
                          class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="EsResponsable"
                           class="form-check-input" />

                    <label asp-for="EsResponsable"
                           class="form-check-label">
                        Designar como familiar responsable
                    </label>

                    <div class="form-text">
                        Cada paciente debe tener un responsable.
                        Si designas otro, el anterior dejará de serlo.
                    </div>

                    <span asp-validation-for="EsResponsable"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Guardar relación
                </button>

                <a asp-page="/Familiares"
                   class="btn btn-outline-secondary ms-2">
                    Cancelar
                </a>

            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Relaciones registradas</h5>
        </div>

        <div class="card-body">
            @if (Model.Relaciones.Count == 0)
            {
                <p class="text-muted mb-0">
                    Todavía no hay relaciones entre pacientes y familiares.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Paciente</th>
                                <th>Familiar</th>
                                <th>Parentesco</th>
                                <th>Responsable</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var relacion in Model.Relaciones)
                            {
                                <tr>
                                    <td>
                                        @(relacion.Paciente?.Nombres ?? "")
                                        @(relacion.Paciente?.Apellidos ?? "")
                                    </td>

                                    <td>
                                        @(relacion.Familiar?.Nombres ?? "")
                                        @(relacion.Familiar?.Apellidos ?? "")
                                    </td>

                                    <td>@relacion.Parentesco</td>

                                    <td>
                                        @if (relacion.EsResponsable)
                                        {
                                            <span class="badge bg-success">
                                                Sí
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                No
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>
