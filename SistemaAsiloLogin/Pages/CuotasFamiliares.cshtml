@page
@model SistemaAsiloLogin.Pages.CuotasFamiliaresModel

@{
    ViewData["Title"] = "Cuotas Familiares";
}

@section Styles {
    <link rel="stylesheet" href="~/css/solicitudes-citas.css" asp-append-version="true" />
}

<div class="modulo-medico">
    <a asp-page="/CajaPagos" class="btn btn-outline-secondary mb-3"> 
    ← Volver a Caja y Pagos
</a>
    <div class="modulo-encabezado">
        <h2>Cuotas Familiares</h2>
        <p class="modulo-descripcion">
            Registra las cuotas familiares y consulta sus montos y estados.
        </p>
    </div>

<form method="post" class="formulario-modulo">

   <div class="campo-modulo">
        <label>Paciente</label>

        <select asp-for="Cuota.IdPaciente">

            <option value="">
                Seleccione un paciente
            </option>

            @foreach (var paciente in Model.Pacientes)
            {
                <option value="@paciente.IdPaciente">
                    @paciente.Nombres @paciente.Apellidos
                </option>
            }

        </select>
    </div>

    <div class="campo-modulo">
        <label>Fecha de la cuota</label>

        <input asp-for="Cuota.FechaCuota"
               type="date" />
    </div>

    <div class="campo-modulo">
        <label>Monto</label>

        <input asp-for="Cuota.Monto"
               type="number"
               step="0.01" />
    </div>

    <div class="campo-modulo">
        <label>Estado</label>

        <select asp-for="Cuota.Estado">

            <option value="Pendiente">
                Pendiente
            </option>

            <option value="Pagada">
                Pagada
            </option>

        </select>
    </div>

  <button type="submit" class="btn-modulo campo-completo">
    Registrar Cuota
</button>>

</form>

<hr />

<h3 class="seccion-registros">Cuotas Registradas</h3>

<div class="tabla-responsive">
    <table class="tabla-modulo">

    <thead>

        <tr>
            <th>ID</th>
            <th>Paciente</th>
            <th>Fecha</th>
            <th>Monto</th>
            <th>Estado</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var cuota in Model.Cuotas)
        {
            <tr>

                <td>@cuota.IdCuota</td>

                <td>
                    @cuota.Paciente?.Nombres
                    @cuota.Paciente?.Apellidos
                </td>

                <td>
                    @cuota.FechaCuota.ToString("dd/MM/yyyy")
                </td>

                <td>
                    Q @cuota.Monto
                </td>

                <td>
                    @cuota.Estado
                </td>

            </tr>
        }

       </tbody>
    </table>
</div>
</div>